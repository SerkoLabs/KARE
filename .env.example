# Client-readable Supabase configuration only.
# These values identify a Supabase project but do not grant privileged access.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only secrets (names documented here intentionally; never prefix with EXPO_PUBLIC_).
# Configure these only in trusted server / Supabase Edge Function environments:
# TMDB_READ_ACCESS_TOKEN=
# SUPABASE_SERVICE_ROLE_KEY=
