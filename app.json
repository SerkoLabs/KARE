{
  "expo": {
    "name": "KARE",
    "slug": "kare",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "kare",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101010",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.serkolabs.kare"
    },
    "android": {
      "package": "com.serkolabs.kare",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
